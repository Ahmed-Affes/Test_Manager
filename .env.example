# Supabase Public Configuration (used in browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Supabase Server-Only Configuration (used in secure server actions/routes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key

# Optional: Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
